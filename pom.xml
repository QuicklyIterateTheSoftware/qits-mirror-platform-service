<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- qits-platform-mirror — the platform's pull-through caches, and nothing else
         (byte-plane-split-plan.md phase 2).

         It owns THREE repository types: NPM_PROXY (a cache of npmjs), MAVEN_PROXY (a cache of Maven
         Central) and OCI_MIRROR (a pull-through of Docker Hub, quay and the Red Hat registry).
         Hosted publishing is not its job and cannot be: the hosted profiles that ride in on the
         qits-registries jars are vetoed at build time (quarkus.arc.exclude-types in
         application.properties), so the set of registered types and the set of keys
         ck_artifact_repository_type allows are the same three.

         ONE MODULE. The reference this is modelled on (qits-platform-artifacts) is four modules
         because its libraries are its own; here the libraries are two separate repositories
         (qits-blobstore, qits-registries) and what is left is an application — configuration, a
         schema, a seeder, and now the explorer surface: a read-only admin API at /mirror/api and the
         Angular client Quinoa serves at /mirror/. A parent pom over one child would be ceremony.

         No qits-auth-core: nothing publishes to this service, so it needs no machine-token
         enforcement, and a cache that authenticated its readers would be a cache nothing could
         read. Pulls are anonymous on qits-net, exactly as they are today — and the admin API adds
         nothing to defend, because it has no write. -->
    <groupId>eu.wohlben.qits</groupId>
    <artifactId>qits-platform-mirror</artifactId>
    <version>2026.813.163303</version>
    <packaging>quarkus</packaging>
    <name>qits-platform-mirror</name>

    <properties>
        <!-- The PG-only blob store. Both libraries moved their bytes out of the filesystem and into
             three PostgreSQL tables. The campaign has released, so both are pinned at their
             calver. -->
        <qits.blobstore.version>2026.814.71936</qits.blobstore.version>
        <qits.registries.version>2026.814.72113</qits.registries.version>
        <!-- The platform's datasource resilience baseline: qits-db-core carries PatientPgDriver,
             which the datasource block in application.properties names, and qits-arch-rules carries
             the test that fails this build when a postgresql datasource is missing a line of that
             block. Published by libs/qits-integrations-quarkus, so they come from the same
             repository as the two above. -->
        <qits.db-core.version>2026.811.165001</qits.db-core.version>
        <qits.arch-rules.version>2026.811.165001</qits.arch-rules.version>
        <!-- Where the two library repositories' jars come from when they are not in ~/.m2 — which
             is every build that is not a developer's. The image build overrides it with the address
             the platform's Maven repository answers on qits-net; see docker/Dockerfile. -->
        <qits.maven.repository.url>http://registry.dev.localhost:8080/artifacts/maven/maven</qits.maven.repository.url>

        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <quarkus.platform.artifact-id>quarkus-bom</quarkus.platform.artifact-id>
        <quarkus.platform.group-id>io.quarkus.platform</quarkus.platform.group-id>
        <quarkus.platform.version>3.34.6</quarkus.platform.version>

        <!-- Quinoa is a Quarkiverse extension: not in quarkus-bom, and its version does NOT track the
             platform's. 2.8.2 is built against Quarkus 3.27.3 LTS — older than the 3.34.6 above,
             which is the direction that works, since an extension compiled against an older core
             runs on a newer one. 2.8.3 is built against 3.36.2 and would be an extension asking this
             core for API it may not have. Bump it only past a platform bump. Same pin as
             qits-artifacts and every other SPA-serving service. -->
        <quinoa.version>2.8.2</quinoa.version>

        <compiler-plugin.version>3.15.0</compiler-plugin.version>
        <surefire-plugin.version>3.5.4</surefire-plugin.version>
        <jandex-plugin.version>3.4.0</jandex-plugin.version>
        <lombok.version>1.18.38</lombok.version>
        <lombok-mapstruct-binding.version>0.2.0</lombok-mapstruct-binding.version>
        <mapstruct.version>1.6.3</mapstruct.version>

        <!-- Real PostgreSQL binaries, resolved as ordinary Maven artifacts and spawned as a child
             process by the suite. The platform's own convention (qits-events): a clone must test
             green with no docker, and the schema still has to be exercised against the database it
             ships on. -->
        <zonky.embedded-postgres.version>2.2.2</zonky.embedded-postgres.version>
        <zonky.postgres-binaries.version>18.4.0</zonky.postgres-binaries.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>${quarkus.platform.artifact-id}</artifactId>
                <version>${quarkus.platform.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.zonky.test.postgres</groupId>
                <artifactId>embedded-postgres-binaries-bom</artifactId>
                <version>${zonky.postgres-binaries.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.zonky.test</groupId>
                <artifactId>embedded-postgres</artifactId>
                <version>${zonky.embedded-postgres.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
                <scope>provided</scope>
            </dependency>
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>
            <dependency>
                <groupId>io.quarkiverse.quinoa</groupId>
                <artifactId>quarkus-quinoa</artifactId>
                <version>${quinoa.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <repositories>
        <!-- The platform's own Maven repository, where qits-blobstore and the three qits-registries
             jars are published. The id is what a locally cached copy is recorded under, so it has to
             stay `qits-maven` or an offline build refuses an artifact it already has — and it is the
             id .qits-maven-settings.xml mirrors, which is how the image build gets an address at
             all. -->
        <repository>
            <id>qits-maven</id>
            <url>${qits.maven.repository.url}</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <!-- The content-addressed blob store: the repository/record entities, the disk index and
                 the open type registration every profile plugs into. -->
            <groupId>${project.groupId}</groupId>
            <artifactId>qits-blobstore</artifactId>
            <version>${qits.blobstore.version}</version>
        </dependency>
        <dependency>
            <!-- The npm wire and store — both halves, hosted and cache. Only NPM_PROXY is wired
                 here; NpmPackagesProfile is excluded from discovery so no row can carry its key. -->
            <groupId>${project.groupId}</groupId>
            <artifactId>qits-registries-npm</artifactId>
            <version>${qits.registries.version}</version>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>qits-registries-maven</artifactId>
            <version>${qits.registries.version}</version>
        </dependency>
        <dependency>
            <!-- The /v2 Distribution routes, the mirror upstream table and the miss path. -->
            <groupId>${project.groupId}</groupId>
            <artifactId>qits-registries-oci</artifactId>
            <version>${qits.registries.version}</version>
        </dependency>
        <dependency>
            <!-- The admin API at /mirror/api — two read-only listings the explorer draws. It is the
                 only JAX-RS surface here; every byte this service serves is still a raw Vert.x route
                 in a library jar. -->
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest</artifactId>
        </dependency>
        <dependency>
            <!-- The listings are records, so something has to write them as JSON. -->
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest-jackson</artifactId>
        </dependency>
        <dependency>
            <!-- The explorer SPA. Quinoa runs the npm build in src/main/webui (the
                 qits-platform-spa-mirror submodule) during augmentation and serves the result as
                 static resources — see the quarkus.quinoa.* block in application.properties.

                 IT IS WHY quarkus-undertow MUST STAY OUT. Quinoa's production static serving goes
                 through Quarkus' own static-resource route, which undertow's servlet stack takes
                 over and then cannot find — a packaged process that serves the API and answers the
                 SPA with a 404. Nothing here needs a servlet: the three wire protocols are raw
                 Vert.x routes and the admin API is quarkus-rest. Check `dependency:tree` before
                 adding anything that sounds like a web framework. -->
            <groupId>io.quarkiverse.quinoa</groupId>
            <artifactId>quarkus-quinoa</artifactId>
        </dependency>
        <dependency>
            <!-- /mirror/q/health/ready — the readiness endpoint qits-cd's health gate curls. -->
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-smallrye-health</artifactId>
        </dependency>
        <dependency>
            <!-- The cache eviction sweep's clock, and this service's only scheduled work. Nothing
                 else triggers eviction: the policy is a window in configuration, not a decision
                 somebody takes per run. -->
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-scheduler</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-hibernate-orm-panache</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-jdbc-postgresql</artifactId>
        </dependency>
        <dependency>
            <!-- Two things, and the scope changed when the second arrived.

                 PatientPgDriver is the driver the mirror datasource opens its connections through;
                 config names it as a string, so it alone would need only runtime scope. It delegates
                 to org.postgresql.Driver and keeps asking for up to 14s while postgres is coming
                 back — which is what stops a cutover from teaching every docker and maven client
                 that an artifact is absent. See the datasource block in application.properties.

                 DbRetry is the other half, for a connection that dies MID-FLIGHT, after statements
                 ran — which the pool cannot help with. The admin API's two listings are reads a
                 caller is waiting on, so they are exactly its documented call site, and naming it in
                 source is what makes this a compile dependency. -->
            <groupId>${project.groupId}</groupId>
            <artifactId>qits-db-core</artifactId>
            <version>${qits.db-core.version}</version>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-flyway</artifactId>
        </dependency>
        <dependency>
            <!-- Flyway 10 split its database support out of core; without this the postgres
                 lineage has no dialect and migrate-at-start fails at the first statement. -->
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <!-- OTLP export to qits-observability, on the same settings every other service ships.
                 Dark outside a deployment (see application.properties). -->
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-opentelemetry</artifactId>
        </dependency>

        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- The platform's shared rules, here for DatasourceBaselineRules. Test scope: they run
                 in the build and ship in nothing. -->
            <groupId>${project.groupId}</groupId>
            <artifactId>qits-arch-rules</artifactId>
            <version>${qits.arch-rules.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.zonky.test</groupId>
            <artifactId>embedded-postgres</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- Named per architecture on purpose: the binaries are separate artifacts and zonky
                 picks one at run time, so an unnamed arch fails in the middle of a suite rather
                 than during resolution. -->
            <groupId>io.zonky.test.postgres</groupId>
            <artifactId>embedded-postgres-binaries-linux-amd64</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.zonky.test.postgres</groupId>
            <artifactId>embedded-postgres-binaries-linux-arm64v8</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.zonky.test.postgres</groupId>
            <artifactId>embedded-postgres-binaries-darwin-arm64v8</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <!-- This module is the DEPLOYABLE, and `<packaging>quarkus</packaging>` above is
                     what says so: it binds generate-code, generate-code-tests and build into the
                     lifecycle, so augmentation is not an execution someone can misplace. -->
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
                <version>${quarkus.platform.version}</version>
                <extensions>true</extensions>
            </plugin>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${compiler-plugin.version}</version>
                <configuration>
                    <parameters>true</parameters>
                    <useIncrementalCompilation>false</useIncrementalCompilation>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${mapstruct.version}</version>
                        </path>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok-mapstruct-binding</artifactId>
                            <version>${lombok-mapstruct-binding.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire-plugin.version}</version>
                <configuration>
                    <systemPropertyVariables>
                        <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>io.smallrye</groupId>
                <artifactId>jandex-maven-plugin</artifactId>
                <version>${jandex-plugin.version}</version>
                <executions>
                    <execution>
                        <id>make-index</id>
                        <goals>
                            <goal>jandex</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- GraalVM native build: `-Dnative` disables the fast-jar and enables the native image.
             `-Dnative` is a PROFILE TRIGGER and nothing else — the property Quarkus reads is
             quarkus.native.enabled, so without this block `./mvnw verify -Dnative` builds a jar,
             reports BUILD SUCCESS and ships no binary at all.

             There is no `skipITs` line here, unlike the siblings': this repository has no failsafe
             plugin and no *IT, so flipping it would be config for a plugin that is not bound. Add
             both together or neither. -->
        <profile>
            <id>native</id>
            <activation>
                <property>
                    <name>native</name>
                </property>
            </activation>
            <properties>
                <quarkus.package.jar.enabled>false</quarkus.package.jar.enabled>
                <quarkus.native.enabled>true</quarkus.native.enabled>
            </properties>
        </profile>
    </profiles>
</project>
